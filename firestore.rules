rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasActiveAccount() {
      return signedIn() &&
          get(/databases/$(database)/documents/TAI_KHOAN/$(request.auth.uid))
              .data.isActive == true;
    }

    function hasActiveRole(role) {
      return hasActiveAccount() &&
          get(/databases/$(database)/documents/TAI_KHOAN/$(request.auth.uid))
              .data.role == role;
    }

    function isAdmin() {
      return hasActiveRole('admin');
    }

    function ownsPatient(patientId) {
      return hasActiveAccount() &&
          get(/databases/$(database)/documents/BENH_NHAN/$(patientId))
              .data.authUserId == request.auth.uid;
    }

    // Profile edits need only verify the signed-in Firebase user owns the
    // profile document. This avoids coupling a patient's own profile update
    // to a separate account-document lookup.
    function ownsPatientProfile(patientId) {
      return signedIn() &&
          get(/databases/$(database)/documents/BENH_NHAN/$(patientId))
              .data.authUserId == request.auth.uid;
    }

    function isDoctor(doctorId) {
      let doctor = get(/databases/$(database)/documents/BAC_SI/$(doctorId));
      let account = get(/databases/$(database)/documents/TAI_KHOAN/$(request.auth.uid));
      return signedIn() &&
          account.data.isActive == true &&
          account.data.role == 'doctor' &&
          doctor.data.status == 'ACTIVE' &&
          (doctor.data.userId == request.auth.uid ||
              (account.data.keys().hasAll(['accountKey']) &&
                  account.data.accountKey is string &&
                  doctor.data.userId == account.data.accountKey));
    }

    function validAppointmentCreateShape() {
      return request.resource.data.keys().hasAll([
            'patientId',
            'doctorId',
            'workScheduleId',
            'timeSlotId',
            'specialtyId',
            'appointmentDate',
            'startTime',
            'endTime',
            'bookedAt',
            'status',
            'peopleCount',
            'createdAt',
            'updatedAt'
          ]) &&
          request.resource.data.keys().hasOnly([
            'patientId',
            'doctorId',
            'workScheduleId',
            'timeSlotId',
            'specialtyId',
            'appointmentDate',
            'startTime',
            'endTime',
            'bookedAt',
            'status',
            'reason',
            'note',
            'symptoms',
            'peopleCount',
            'createdAt',
            'updatedAt'
          ]) &&
          request.resource.data.patientId is string &&
          request.resource.data.doctorId is string &&
          request.resource.data.workScheduleId is string &&
          request.resource.data.timeSlotId is string &&
          request.resource.data.specialtyId is string &&
          request.resource.data.appointmentDate is timestamp &&
          request.resource.data.startTime is string &&
          request.resource.data.endTime is string &&
          request.resource.data.bookedAt is timestamp &&
          request.resource.data.peopleCount is int &&
          request.resource.data.peopleCount > 0 &&
          request.resource.data.status == 'PENDING';
    }

    // A new appointment must be paired with the matching slot reservation in
    // one transaction. Client validation improves the UX, but these checks
    // make the date, time and capacity constraints authoritative in Firebase.
    function canCreateAppointment(appointmentId) {
      let slot = get(/databases/$(database)/documents/CA_KHAM/$(request.resource.data.timeSlotId));
      let schedule = get(/databases/$(database)/documents/LICH_LAM_VIEC/$(request.resource.data.workScheduleId));
      let slotAfter = getAfter(/databases/$(database)/documents/CA_KHAM/$(request.resource.data.timeSlotId));
      let newCount = slot.data.bookedCount + request.resource.data.peopleCount;
      return validAppointmentCreateShape() &&
          ownsPatient(request.resource.data.patientId) &&
          slot.data.status == 'AVAILABLE' &&
          slot.data.capacity is int &&
          slot.data.capacity > 0 &&
          slot.data.bookedCount is int &&
          slot.data.bookedCount >= 0 &&
          slot.data.workScheduleId == request.resource.data.workScheduleId &&
          slot.data.doctorId == request.resource.data.doctorId &&
          schedule.data.status == 'ACTIVE' &&
          schedule.data.doctorId == request.resource.data.doctorId &&
          request.resource.data.appointmentDate == schedule.data.workDate &&
          request.resource.data.startTime == slot.data.startTime &&
          request.resource.data.endTime == slot.data.endTime &&
          slotAfter.data.bookedCount == newCount &&
          slotAfter.data.appointmentId == appointmentId &&
          slotAfter.data.reservationCounts is map &&
          slotAfter.data.reservationCounts[appointmentId] ==
              request.resource.data.peopleCount &&
          ((newCount < slot.data.capacity && slotAfter.data.status == 'AVAILABLE') ||
              (newCount == slot.data.capacity && slotAfter.data.status == 'BOOKED'));
    }

    // A patient may create exactly one unread confirmation notification only
    // when the paired appointment is created in this same transaction.
    function canCreateOwnBookingNotification() {
      let appointment = getAfter(/databases/$(database)/documents/LICH_HEN/$(request.resource.data.appointmentId));
      return request.resource.data.keys().hasAll([
            'patientId',
            'appointmentId',
            'title',
            'content',
            'isRead',
            'createdAt'
          ]) &&
          request.resource.data.keys().hasOnly([
            'patientId',
            'appointmentId',
            'title',
            'content',
            'isRead',
            'createdAt'
          ]) &&
          request.resource.data.patientId is string &&
          request.resource.data.appointmentId is string &&
          request.resource.data.title == 'Đặt lịch thành công' &&
          request.resource.data.content is string &&
          request.resource.data.content.size() > 0 &&
          request.resource.data.content.size() <= 300 &&
          request.resource.data.isRead == false &&
          request.resource.data.createdAt is timestamp &&
          request.resource.data.createdAt == request.time &&
          ownsPatient(request.resource.data.patientId) &&
          appointment.data.patientId == request.resource.data.patientId &&
          appointment.data.status == 'PENDING' &&
          appointment.data.createdAt == request.time;
    }

    // A cancellation notification is valid only when its paired appointment
    // has been cancelled by the same patient in the current transaction.
    function canCreateOwnCancellationNotification() {
      let appointment = getAfter(/databases/$(database)/documents/LICH_HEN/$(request.resource.data.appointmentId));
      return request.resource.data.keys().hasAll([
            'patientId',
            'appointmentId',
            'title',
            'content',
            'isRead',
            'createdAt'
          ]) &&
          request.resource.data.keys().hasOnly([
            'patientId',
            'appointmentId',
            'title',
            'content',
            'isRead',
            'createdAt'
          ]) &&
          request.resource.data.patientId is string &&
          request.resource.data.appointmentId is string &&
          request.resource.data.title == 'Hủy lịch thành công' &&
          request.resource.data.content is string &&
          request.resource.data.content.size() > 0 &&
          request.resource.data.content.size() <= 300 &&
          request.resource.data.isRead == false &&
          request.resource.data.createdAt is timestamp &&
          request.resource.data.createdAt == request.time &&
          ownsPatient(request.resource.data.patientId) &&
          appointment.data.patientId == request.resource.data.patientId &&
          appointment.data.status == 'CANCELLED' &&
          appointment.data.updatedAt == request.time;
    }

    function canBookSlot(slotId) {
      let appointment = getAfter(/databases/$(database)/documents/LICH_HEN/$(request.resource.data.appointmentId));
      let newCount = request.resource.data.bookedCount;
      let capacity = resource.data.capacity;
      return hasActiveAccount() &&
          resource.data.status == 'AVAILABLE' &&
          resource.data.capacity is int &&
          resource.data.capacity > 0 &&
          resource.data.bookedCount is int &&
          resource.data.bookedCount >= 0 &&
          request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'bookedCount',
                'status',
                'appointmentId',
                'reservationCounts',
                'updatedAt'
              ]) &&
          request.resource.data.workScheduleId == resource.data.workScheduleId &&
          request.resource.data.doctorId == resource.data.doctorId &&
          appointment.data.status == 'PENDING' &&
          appointment.data.timeSlotId == slotId &&
          appointment.data.workScheduleId == resource.data.workScheduleId &&
          appointment.data.doctorId == resource.data.doctorId &&
          appointment.data.peopleCount is int &&
          appointment.data.peopleCount > 0 &&
          request.resource.data.reservationCounts is map &&
          request.resource.data.reservationCounts[
              request.resource.data.appointmentId] == appointment.data.peopleCount &&
          (!resource.data.keys().hasAll(['reservationCounts']) ||
              request.resource.data.reservationCounts
                  .diff(resource.data.reservationCounts)
                  .affectedKeys()
                  .hasOnly([request.resource.data.appointmentId])) &&
          newCount == resource.data.bookedCount + appointment.data.peopleCount &&
          newCount > resource.data.bookedCount &&
          newCount <= capacity &&
          ((newCount < capacity && request.resource.data.status == 'AVAILABLE') ||
              (newCount == capacity && request.resource.data.status == 'BOOKED')) &&
          ownsPatient(appointment.data.patientId);
    }

    function canUpdateOwnAppointment() {
      return ownsPatient(resource.data.patientId) &&
          request.resource.data.patientId == resource.data.patientId &&
          request.resource.data.doctorId == resource.data.doctorId &&
          request.resource.data.workScheduleId == resource.data.workScheduleId &&
          request.resource.data.timeSlotId == resource.data.timeSlotId &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['note', 'updatedAt']);
    }

    // A cancellation must release the exact number of occupied places in the
    // same transaction.  The client keeps appointmentId on a slot for
    // backwards compatibility, so cancellation does not attempt to clear it.
    function canCancelOwnAppointment(appointmentId) {
      let slotBefore = get(/databases/$(database)/documents/CA_KHAM/$(resource.data.timeSlotId));
      let slotAfter = getAfter(/databases/$(database)/documents/CA_KHAM/$(resource.data.timeSlotId));
      let expectedCount = resource.data.peopleCount;
      return ownsPatient(resource.data.patientId) &&
          resource.data.status in ['PENDING', 'CONFIRMED'] &&
          request.resource.data.patientId == resource.data.patientId &&
          request.resource.data.doctorId == resource.data.doctorId &&
          request.resource.data.workScheduleId == resource.data.workScheduleId &&
          request.resource.data.timeSlotId == resource.data.timeSlotId &&
          request.resource.data.status == 'CANCELLED' &&
          request.resource.data.cancellationReason is string &&
          request.resource.data.cancellationReason.size() > 0 &&
          request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'cancellationReason', 'updatedAt']) &&
          slotBefore.data.bookedCount is int &&
          slotAfter.data.bookedCount == slotBefore.data.bookedCount - expectedCount &&
          slotAfter.data.bookedCount >= 0 &&
          slotAfter.data.appointmentId == appointmentId &&
          slotAfter.data.reservationCounts is map &&
          !slotAfter.data.reservationCounts.keys().hasAll([appointmentId]);
    }

    function canRescheduleOwnAppointment(appointmentId) {
      let oldSlot = get(/databases/$(database)/documents/CA_KHAM/$(resource.data.timeSlotId));
      let oldSlotAfter = getAfter(/databases/$(database)/documents/CA_KHAM/$(resource.data.timeSlotId));
      let newSlot = get(/databases/$(database)/documents/CA_KHAM/$(request.resource.data.timeSlotId));
      let newSlotAfter = getAfter(/databases/$(database)/documents/CA_KHAM/$(request.resource.data.timeSlotId));
      let newSchedule = get(/databases/$(database)/documents/LICH_LAM_VIEC/$(request.resource.data.workScheduleId));
      return ownsPatient(resource.data.patientId) &&
          resource.data.status in ['PENDING', 'CONFIRMED'] &&
          request.resource.data.patientId == resource.data.patientId &&
          request.resource.data.doctorId == resource.data.doctorId &&
          request.resource.data.specialtyId == resource.data.specialtyId &&
          request.resource.data.timeSlotId != resource.data.timeSlotId &&
          request.resource.data.status == 'PENDING' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'workScheduleId',
            'timeSlotId',
            'appointmentDate',
            'startTime',
            'endTime',
            'status',
            'updatedAt'
          ]) &&
          newSchedule.data.status == 'ACTIVE' &&
          newSchedule.data.doctorId == resource.data.doctorId &&
          newSlot.data.workScheduleId == request.resource.data.workScheduleId &&
          newSlot.data.doctorId == resource.data.doctorId &&
          request.resource.data.appointmentDate == newSchedule.data.workDate &&
          request.resource.data.startTime == newSlot.data.startTime &&
          request.resource.data.endTime == newSlot.data.endTime &&
          oldSlot.data.bookedCount - resource.data.peopleCount ==
              oldSlotAfter.data.bookedCount &&
          newSlot.data.bookedCount + resource.data.peopleCount ==
              newSlotAfter.data.bookedCount &&
          oldSlotAfter.data.appointmentId == appointmentId &&
          newSlotAfter.data.appointmentId == appointmentId &&
          oldSlotAfter.data.reservationCounts is map &&
          newSlotAfter.data.reservationCounts is map &&
          !oldSlotAfter.data.reservationCounts.keys().hasAll([appointmentId]) &&
          newSlotAfter.data.reservationCounts[appointmentId] ==
              resource.data.peopleCount;
    }

    function canDoctorUpdateAppointment() {
      return isDoctor(resource.data.doctorId) &&
          request.resource.data.patientId == resource.data.patientId &&
          request.resource.data.doctorId == resource.data.doctorId &&
          request.resource.data.workScheduleId == resource.data.workScheduleId &&
          request.resource.data.timeSlotId == resource.data.timeSlotId &&
          request.resource.data.status in ['PENDING', 'CONFIRMED', 'COMPLETED', 'CANCELLED', 'NO_SHOW'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'note',
            'queueNumber',
            'checkInTime',
            'cancellationReason',
            'updatedAt'
          ]);
    }

    function canManageOwnSchedule() {
      return isDoctor(resource.data.doctorId) &&
          request.resource.data.doctorId == resource.data.doctorId;
    }

    function canManageOwnSlot() {
      let schedule = get(/databases/$(database)/documents/LICH_LAM_VIEC/$(resource.data.workScheduleId));
      return isDoctor(schedule.data.doctorId) &&
          request.resource.data.workScheduleId == resource.data.workScheduleId &&
          request.resource.data.doctorId == resource.data.doctorId &&
          request.resource.data.bookedCount == resource.data.bookedCount &&
          request.resource.data.appointmentId == resource.data.appointmentId;
    }

    function canReleaseBookedSlot(slotId) {
      let slot = resource.data;
      let appointment = getAfter(/databases/$(database)/documents/LICH_HEN/$(request.resource.data.appointmentId));
      return hasActiveAccount() &&
          request.resource.data.appointmentId is string &&
          (appointment.data.status == 'CANCELLED' ||
              (appointment.data.status == 'PENDING' &&
                  appointment.data.timeSlotId != slotId)) &&
          appointment.data.peopleCount is int &&
          appointment.data.peopleCount > 0 &&
          request.resource.data.diff(slot).affectedKeys()
              .hasOnly([
                'bookedCount',
                'status',
                'appointmentId',
                'reservationCounts',
                'updatedAt'
              ]) &&
          request.resource.data.bookedCount ==
              slot.bookedCount - appointment.data.peopleCount &&
          request.resource.data.bookedCount >= 0 &&
          request.resource.data.reservationCounts is map &&
          !request.resource.data.reservationCounts.keys()
              .hasAll([request.resource.data.appointmentId]) &&
          (!slot.keys().hasAll(['reservationCounts']) ||
              request.resource.data.reservationCounts
                  .diff(slot.reservationCounts)
                  .affectedKeys()
                  .hasOnly([request.resource.data.appointmentId])) &&
          ((request.resource.data.bookedCount < slot.capacity &&
                  request.resource.data.status == 'AVAILABLE') ||
              (request.resource.data.bookedCount == slot.capacity &&
                  request.resource.data.status == 'BOOKED')) &&
          ownsPatient(appointment.data.patientId);
    }

    match /TAI_KHOAN/{accountId} {
      allow read: if signedIn() && (request.auth.uid == accountId || isAdmin());
      allow create: if signedIn() &&
          request.auth.uid == accountId &&
          request.resource.data.keys().hasOnly([
            'email', 'fullName', 'phone', 'role', 'isActive', 'createdAt', 'updatedAt'
          ]) &&
          request.resource.data.role == 'patient' &&
          request.resource.data.isActive == true;
      allow update: if isAdmin() ||
          (signedIn() &&
              request.auth.uid == accountId &&
              request.resource.data.role == resource.data.role &&
              request.resource.data.isActive == resource.data.isActive &&
              request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['email', 'fullName', 'phone', 'updatedAt']));
      allow delete: if isAdmin();
    }

    match /CHUYEN_KHOA/{specialtyId} {
      allow read: if hasActiveAccount();
      allow write: if isAdmin();
    }

    match /BAC_SI/{doctorId} {
      allow read: if hasActiveAccount();
      allow write: if isAdmin();
    }

    match /BENH_NHAN/{patientId} {
      // Keep the query in PatientFirebaseDatasource valid: Firestore can
      // prove a `where('authUserId', '==', request.auth.uid)` query only when
      // this condition is expressed against the queried document itself.
      allow read: if isAdmin() ||
          (signedIn() && resource.data.authUserId == request.auth.uid);
      allow create: if isAdmin() ||
          (signedIn() && request.resource.data.authUserId == request.auth.uid);
      allow update: if isAdmin() ||
          (ownsPatientProfile(patientId) &&
              request.resource.data.authUserId == resource.data.authUserId &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'fullName',
                'phone',
                'email',
                'dateOfBirth',
                'gender',
                'address',
                'avatarUrl',
                'insuranceNumber',
                'ethnicity',
                'occupation',
                'ward',
                'district',
                'province',
                'country',
                'nationalId',
                'relationshipToAccountHolder',
                'updatedAt'
              ]));
      allow delete: if isAdmin();
    }

    match /LICH_LAM_VIEC/{scheduleId} {
      allow read: if hasActiveAccount();
      allow create: if isAdmin() || isDoctor(request.resource.data.doctorId);
      allow update, delete: if isAdmin() || canManageOwnSchedule();
    }

    match /CA_KHAM/{slotId} {
      allow read: if hasActiveAccount();
      allow create: if isAdmin() ||
          isDoctor(get(/databases/$(database)/documents/LICH_LAM_VIEC/$(request.resource.data.workScheduleId)).data.doctorId);
      allow update: if isAdmin() || canManageOwnSlot() || canBookSlot(slotId) ||
          canReleaseBookedSlot(slotId);
      allow delete: if isAdmin() ||
          isDoctor(get(/databases/$(database)/documents/LICH_LAM_VIEC/$(resource.data.workScheduleId)).data.doctorId);
    }

    match /LICH_HEN/{appointmentId} {
      allow read: if isAdmin() || ownsPatient(resource.data.patientId) ||
          isDoctor(resource.data.doctorId);
      allow create: if canCreateAppointment(appointmentId);
      allow update: if isAdmin() || canDoctorUpdateAppointment() ||
          canUpdateOwnAppointment() || canCancelOwnAppointment(appointmentId) ||
          canRescheduleOwnAppointment(appointmentId);
      allow delete: if isAdmin();
    }

    match /THANH_TOAN/{paymentId} {
      allow read: if isAdmin() || ownsPatient(resource.data.patientId);
      allow create, update, delete: if isAdmin();
    }

    match /HO_SO_SUC_KHOE/{recordId} {
      allow read: if isAdmin() || ownsPatient(resource.data.patientId) ||
          isDoctor(resource.data.doctorId);
      allow create: if isAdmin() || isDoctor(request.resource.data.doctorId);
      allow update: if isAdmin() || isDoctor(resource.data.doctorId);
      allow delete: if isAdmin() || isDoctor(resource.data.doctorId);
    }

    match /KET_QUA_CLS/{resultId} {
      allow read: if isAdmin() || ownsPatient(resource.data.patientId) ||
          (resource.data.doctorId is string && isDoctor(resource.data.doctorId));
      allow create: if isAdmin() ||
          (request.resource.data.doctorId is string &&
              isDoctor(request.resource.data.doctorId));
      allow update, delete: if isAdmin() ||
          (resource.data.doctorId is string && isDoctor(resource.data.doctorId));
    }

    match /PHAN_HOI/{feedbackId} {
      allow read: if isAdmin() || ownsPatient(resource.data.patientId);
      allow create: if ownsPatient(request.resource.data.patientId) &&
          request.resource.data.content is string &&
          request.resource.data.content.size() > 0 &&
          request.resource.data.rating is number &&
          request.resource.data.rating >= 1 &&
          request.resource.data.rating <= 5;
      allow update, delete: if isAdmin();
    }

    // NotificationFirebaseDatasource and appointment transactions use the
    // Vietnamese uppercase collection name. Keeping the rule path identical
    // to the client schema is required for the paired booking/cancellation
    // transaction to be authorized.
    match /THONG_BAO/{notificationId} {
      allow read: if isAdmin() || ownsPatient(resource.data.patientId);
      allow create: if isAdmin() ||
          (request.resource.data.doctorId is string &&
              isDoctor(request.resource.data.doctorId)) ||
          canCreateOwnBookingNotification() ||
          canCreateOwnCancellationNotification();
      allow update: if isAdmin() ||
          (ownsPatient(resource.data.patientId) &&
              request.resource.data.patientId == resource.data.patientId &&
              request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['isRead']));
      allow delete: if isAdmin();
    }

    // Additional read-only datasets used by the administrator workspace.
    // Mutations are processed by the trusted adminCommand Cloud Function.
    match /{collection}/{recordId} {
      allow read: if collection in [
            'LS_CHAT_AI',
            'CAU_HINH',
            'NHAT_KY_ADMIN',
            'ADMIN_PROVISIONING',
            'ADMIN_NOTES',
            'YEU_CAU_HOAN_TIEN'
          ] && isAdmin();
      allow write: if false;
    }
  }
}
